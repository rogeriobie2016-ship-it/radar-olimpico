{
  "name": "radar-olimpico",
  "version": "0.1.0",
  "private": true,
  "description": "Radar Olímpico: olimpíadas, feiras e oportunidades para estudantes da rede estadual do Ceará (SEDUC/COPES)",
  "scripts": {
    "dev": "next dev -p 3210",
    "validar": "tsx scripts/validar-dados.ts",
    "prebuild": "npm run validar && npm run og",
    "build": "next build",
    "preview": "node scripts/servir-out.mjs",
    "typecheck": "tsc --noEmit",
    "og": "tsx scripts/gerar-og.tsx",
    "testar:escada": "tsx scripts/testar-escada.ts",
    "testar:jogos": "tsx scripts/testar-jogos.ts",
    "testar": "npm run testar:escada && npm run testar:jogos"
  },
  "dependencies": {
    "framer-motion": "^14.9.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.4",
    "tsx": "^4",
    "typescript": "^5.9"
  }
}
